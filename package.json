{
  "name": "reactivegraph",
  "version": "0.1.0",
  "private": true,
  "description": "Reactive execution engine with LangGraph migration compatibility",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format:check": "prettier --check \"packages/**/*.{ts,json}\"",
    "format:write": "prettier --write \"packages/**/*.{ts,json}\"",
    "benchmark": "vitest run benchmarks"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@reactivegraph/driver": "workspace:*",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
